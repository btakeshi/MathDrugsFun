<script src="{{ "/assets/js/explain.js" | relative_url }}"></script>

<script>
ToolEngine.init(function() {
  const a = parseFloat(document.getElementById('val-a').value);
  const b = parseFloat(document.getElementById('val-b').value);
  
  if (isNaN(a) || isNaN(b) || a <= 0 || b <= 0) return null;

  const c2 = a * a + b * b; // cの2乗
  const c_root = simplifyRadical(c2); // ルート表記を取得
  const c_decimal = Math.sqrt(c2).toFixed(2); // 小数表記（参考用）

  return [
    { 
      title: "公式", 
      content: "三平方の定理 $a^2 + b^2 = c^2$ を利用します。" 
    },
    { 
      title: "代入", 
      content: `$${a}^2 + ${b}^2 = c^2$ より、<br>$c^2 = ${a*a} + ${b*b} = ${c2}$ となります。` 
    },
    { 
      title: "代入2", 
      content: `$${a}^2 + ${b}^2 = c^2$ より、<br>$c^2 = ${a*a} + ${b*b} = ${c2}$ となります。` 
    },
    { 
      title: "結論", 
      content: `答えは $c = ${c_root}$ です。<br><span style="font-size:0.8rem; color:#888;">(小数では 約 ${c_decimal})</span>` 
    }
  ];
});

/**
 * 数値を √n の形から k√m の形に簡略化する関数
 * 例: 12 -> 2√3, 25 -> 5, 13 -> √13
 */
function simplifyRadical(n) {
  if (n === 0) return "0";
  let k = 1;
  let m = n;

  // n の中から最大の平方数 (i*i) を探す
  for (let i = Math.floor(Math.sqrt(n)); i >= 2; i--) {
    if (n % (i * i) === 0) {
      k = i;
      m = n / (i * i);
      break;
    }
  }

  if (m === 1) return `${k}`; // 整数になる場合 (例: √25 -> 5)
  if (k === 1) return `\\sqrt{${m}}`; // 簡略化できない場合 (例: √13)
  return `${k}\\sqrt{${m}}`; // 簡略化できる場合 (例: 2\sqrt{3})
}
</script>
